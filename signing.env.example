# Copy to signing.env and fill in. package.sh reads it; signing.env is never committed.
IPA_IN="../Instagram 452.0.0.ipa"
TEAM=ABCDE12345
# security find-identity -v -p codesigning
IDENTITY=0000000000000000000000000000000000000000
PROFILE="$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/your-profile.mobileprovision"
# xcrun devicectl list devices
DEVICE=00000000-0000-0000-0000-000000000000
